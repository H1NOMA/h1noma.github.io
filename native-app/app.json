{
  "expo": {
    "name": "КОМИК",
    "slug": "komik",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "komik",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0c110d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.komikdnd.app",
      "associatedDomains": [
        "applinks:komikdnd.ru"
      ]
    },
    "android": {
      "package": "ru.komikdnd.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "komikdnd.ru"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}